  "summary": {
    "zh-Hant": "集合把指定脈絡中的若干對象視為一個整體，並以元素隸屬來描述其內容。"
  },
  "statement": {
    "zh-Hant": "在指定的論域或型別中，集合 A 由哪些對象是其元素來刻畫；具有完全相同元素的集合視為相同。"
  },
  "formula": {
    "tex": "x\\in A",
    "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>∈</mo><mi>A</mi></mrow></math>",
