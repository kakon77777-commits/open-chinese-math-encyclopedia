        "role": "formal_proof",
        "producer_id": "lean-mathlib"
      }
    ],
    "producers": [
      {
        "id": "lean-mathlib",
        "adapter": "formal_system",
        "config_path": "formal/lean/lakefile.toml",
        "status": "active"
      }
    ]
  },
  "formalization": {
    "status": "formalized_lean_set_semantics",
    "target_systems": ["Lean 4", "Mathlib"],
    "next_obligation_zh": "擴充子集合、集合相等與基本集合運算物件，並保持隸屬、包含與等號三種關係分離。"
  },
