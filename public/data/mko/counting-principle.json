  },
  "assumptions": [
    { "id": "a1", "zh-Hant": "被計數的選擇集合或選擇序列是有限的。" },
    { "id": "a2", "zh-Hant": "使用加法原理時，各類別互不重疊，或重疊已被另外修正。" },
    { "id": "a3", "zh-Hant": "使用乘法原理時，每個階段及其可選數量已依先前選擇明確描述。" }
  ],
  "symbols": [
