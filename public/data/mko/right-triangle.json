    }
  },
  "assumptions": [
    { "id": "a1", "zh-Hant": "討論對象是平面中的非退化三角形。" },
    { "id": "a2", "zh-Hant": "角度使用度數或弧度表示，且 90° 與 π/2 表示同一角度。" }
  ],
  "symbols": [
    { "token": "γ", "role": "right_angle", "role_zh": "被指定為直角的內角", "scope": "definition" },
    { "token": "π", "role": "circle_constant", "role_zh": "圓周率", "scope": "definition" }
