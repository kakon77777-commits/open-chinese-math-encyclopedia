  "titles": { "zh-Hant": "直角三角形", "en": "Right triangle" },
  "summary": { "zh-Hant": "具有一個內角為直角的三角形。" },
  "statement": { "zh-Hant": "若三角形的一個內角等於九十度，或以弧度表示為 π/2，則此三角形稱為直角三角形。" },
  "formula": {
    "tex": "\\gamma=\\frac{\\pi}{2}",
    "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>γ</mi><mo>=</mo><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></mrow></math>",
