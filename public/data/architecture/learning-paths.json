        {"object_id":"mko-tends-to-relation","position":3,"requirement":"required","rationale_zh":"理解 Filter.Tendsto 的形式核心。"},
        {"object_id":"mko-euclid-pythagorean-theorem","position":4,"requirement":"optional","rationale_zh":"觀察百科語義到向量及邊長模型的形式橋。"}
