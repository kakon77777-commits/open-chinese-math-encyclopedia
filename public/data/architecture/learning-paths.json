        {"object_id":"mko-euclid-pythagorean-theorem","position":4,"requirement":"optional","rationale_zh":"觀察幾何、代數與證明的連接。"},
        {"object_id":"mko-tends-to-relation","position":4,"requirement":"optional","rationale_zh":"由函數進入分析中的趨近語義。"}
