{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/eveglyph-review-patch-v0.1.json",
  "title": "OCME EveGlyph Review Patch v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "object_id",
    "base_object_sha256",
    "new_object_version",
    "changes"
  ],
  "properties": {
    "schema_version": { "const": "ocme-eveglyph-review-patch-v0.1" },
    "object_id": { "type": "string", "pattern": "^mko-[a-z0-9-]+$" },
    "base_object_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "new_object_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rationale_zh": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "title_zh": { "type": "string", "minLength": 1 },
        "summary_zh": { "type": "string", "minLength": 1 },
        "statement_zh": { "type": "string", "minLength": 1 },
        "explanation_paragraphs_zh": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "common_misconception_zh": { "type": "string", "minLength": 1 },
        "proof_summaries_zh": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
