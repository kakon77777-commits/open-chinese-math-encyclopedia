{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/difficulty-profile-v0.1.json",
  "title": "OCME Difficulty Profile v0.1",
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "meaning", "rationale_zh"],
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 5 },
        "meaning": { "type": "string", "minLength": 2 },
        "rationale_zh": { "type": "string", "minLength": 8 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_id", "profiles"],
  "properties": {
    "schema_version": { "const": "ocme-difficulty-v0.1" },
    "object_id": { "type": "string", "pattern": "^mko-" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "task", "dimensions", "source"],
        "properties": {
          "audience": { "enum": ["general_learner", "upper_secondary", "undergraduate", "graduate", "formalizer"] },
          "task": { "enum": ["recognize", "conceptual_understanding", "routine_calculation", "proof_reading", "proof_construction", "programming", "formalization"] },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prerequisite_depth", "prerequisite_breadth", "abstraction_level", "conceptual_discontinuity", "notation_density", "proof_burden", "computational_burden", "search_construction_burden", "representation_switching", "exception_boundary_density", "intuition_accessibility", "formalization_burden"],
            "properties": {
              "prerequisite_depth": { "$ref": "#/$defs/dimension" },
              "prerequisite_breadth": { "$ref": "#/$defs/dimension" },
              "abstraction_level": { "$ref": "#/$defs/dimension" },
              "conceptual_discontinuity": { "$ref": "#/$defs/dimension" },
              "notation_density": { "$ref": "#/$defs/dimension" },
              "proof_burden": { "$ref": "#/$defs/dimension" },
              "computational_burden": { "$ref": "#/$defs/dimension" },
              "search_construction_burden": { "$ref": "#/$defs/dimension" },
              "representation_switching": { "$ref": "#/$defs/dimension" },
              "exception_boundary_density": { "$ref": "#/$defs/dimension" },
              "intuition_accessibility": { "$ref": "#/$defs/dimension" },
              "formalization_burden": { "$ref": "#/$defs/dimension" }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "reviewed", "version"],
            "properties": {
              "method": { "enum": ["expert_assessment", "learner_data", "ai_candidate", "dependency_analysis", "benchmark"] },
              "reviewed": { "type": "boolean" },
              "reviewer": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
