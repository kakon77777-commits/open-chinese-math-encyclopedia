{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/disagreement-v0.1.json",
  "title": "OCME Disagreement Object v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disagreement_id",
    "candidate_revision_id",
    "issue_key",
    "status",
    "positions",
    "reviews"
  ],
  "properties": {
    "schema_version": {"const": "ocme-disagreement-v0.1"},
    "disagreement_id": {"type": "string", "pattern": "^disagreement-candidate-task-atlas-.+", "minLength": 32},
    "candidate_revision_id": {"type": "string", "pattern": "^candidate-task-atlas-.+-r[0-9]+$"},
    "issue_key": {"type": "string", "minLength": 1},
    "status": {"const": "open"},
    "positions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["support", "oppose", "uncertain"]}
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "candidate_revision_id",
          "issue_key",
          "position",
          "model_family",
          "model_version",
          "role",
          "prompt_class",
          "context_class",
          "source_set_id",
          "tool_set_id",
          "verification_goal"
        ],
        "properties": {
          "review_id": {"type": "string", "minLength": 1},
          "candidate_revision_id": {"type": "string", "pattern": "^candidate-task-atlas-.+-r[0-9]+$"},
          "issue_key": {"type": "string", "minLength": 1},
          "position": {"enum": ["support", "oppose", "uncertain"]},
          "model_family": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "prompt_class": {"type": "string", "minLength": 1},
          "context_class": {"type": "string", "minLength": 1},
          "source_set_id": {"type": "string", "minLength": 1},
          "tool_set_id": {"type": "string", "minLength": 1},
          "verification_goal": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
