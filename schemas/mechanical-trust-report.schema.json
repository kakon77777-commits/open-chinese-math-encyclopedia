{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/mechanical-trust-report-v0.1.json",
  "title": "OCME Mechanical Trust Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "epistemic_scope",
    "candidate_revision_id",
    "candidate_id",
    "target_mko_id",
    "candidate_sha256",
    "candidate_artifact_sha256",
    "source_revision",
    "mechanical_status",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "ocme-mechanical-trust-report-v0.1"},
    "report_id": {"type": "string", "pattern": "^mechanical-candidate-task-atlas-.+", "minLength": 34},
    "epistemic_scope": {"const": "mechanical_only"},
    "candidate_revision_id": {"type": "string", "pattern": "^candidate-task-atlas-.+-r[0-9]+$"},
    "candidate_id": {"type": "string", "pattern": "^mko-", "minLength": 5},
    "target_mko_id": {"type": "string", "pattern": "^mko-", "minLength": 5},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_revision": {"type": "string", "minLength": 1},
    "mechanical_status": {"enum": ["pass", "fail"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "scope",
          "status",
          "executable",
          "args",
          "exit_code",
          "stdout_sha256",
          "stderr_sha256",
          "duration_ms",
          "tool"
        ],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "minLength": 1},
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "status": {"enum": ["pass", "fail"]},
          "executable": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
