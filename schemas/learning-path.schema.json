{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/learning-path-v0.1.json",
  "title": "OCME Learning Path v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title_zh", "audience", "goal_zh", "nodes", "edges", "review"],
  "properties": {
    "schema_version": { "const": "ocme-learning-path-v0.1" },
    "id": { "type": "string", "pattern": "^path-" },
    "title_zh": { "type": "string", "minLength": 3 },
    "audience": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "goal_zh": { "type": "string", "minLength": 8 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "position", "requirement", "rationale_zh"],
        "properties": {
          "object_id": { "type": "string", "pattern": "^mko-" },
          "position": { "type": "integer", "minimum": 1 },
          "requirement": { "enum": ["required", "optional", "remedial"] },
          "rationale_zh": { "type": "string", "minLength": 8 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string", "pattern": "^mko-" },
          "to": { "type": "string", "pattern": "^mko-" },
          "relation": { "enum": ["recommended_before", "required_before", "alternative_entry", "remedial_for", "extends"] }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": { "enum": ["candidate", "reviewed", "deprecated"] },
        "reviewer": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
