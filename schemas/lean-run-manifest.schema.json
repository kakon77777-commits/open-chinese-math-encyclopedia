{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/lean-run-manifest-v0.1.json",
  "title": "OCME Lean Formal Proof Manifest v0.1",
  "type": "object",
  "required": [
    "schema_version", "subject_id", "producer_version", "mathlib_version",
    "toolchain", "command", "theorem_name", "status", "claim_scope",
    "checks", "limitations", "source_paths", "replay"
  ],
  "properties": {
    "schema_version": { "const": "lean-run-manifest-v0.1" },
    "subject_id": { "type": "string", "pattern": "^mko-[a-z0-9-]+$" },
    "producer_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "mathlib_version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "toolchain": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "theorem_name": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "claim_scope": {
      "type": "object",
      "required": ["quantification", "universal_proof", "statement_zh"],
      "properties": {
        "quantification": { "const": "formal_universal" },
        "universal_proof": { "const": true },
        "statement_zh": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_paths": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "replay": {
      "type": "object",
      "required": ["command", "expected_exit_code", "source_artifact"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expected_exit_code": { "const": 0 },
        "source_artifact": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
