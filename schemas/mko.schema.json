{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/mko-v0.1.json",
  "title": "OCME Mathematical Knowledge Object v0.1",
  "type": "object",
  "required": [
    "schema_version", "id", "semantic_family_id", "type", "version",
    "titles", "statement", "formula", "assumptions", "symbols",
    "computational_companions", "verification", "formalization", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "mko-v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "semantic_family_id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["concept", "definition", "axiom", "notation", "formula", "identity", "proposition", "lemma", "theorem", "corollary", "conjecture", "proof", "counterexample", "algorithm", "example", "exercise"] },
    "version": { "type": "string" },
    "titles": { "type": "object", "minProperties": 1 },
    "statement": { "type": "object", "minProperties": 1 },
    "formula": {
      "type": "object",
      "required": ["tex", "mathml", "semantic_ast"],
      "properties": {
        "tex": { "type": "string" },
        "mathml": { "type": "string" },
        "semantic_ast": { "type": "object" }
      }
    },
    "assumptions": { "type": "array", "minItems": 1 },
    "symbols": { "type": "array", "minItems": 1 },
    "computational_companions": { "type": "array" },
    "verification": { "type": "object" },
    "formalization": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
