{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/evidence-v0.1.json",
  "title": "OCME Evidence Object v0.1",
  "type": "object",
  "required": [
    "id", "schema_version", "subject_id", "evidence_type", "status",
    "claim_scope", "producer", "sources", "formula_source_sha256",
    "checks", "limitations", "replay", "digest"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^evidence-sha256-[a-f0-9]{64}$" },
    "schema_version": { "const": "evidence-v0.1" },
    "subject_id": { "type": "string", "pattern": "^mko-[a-z0-9-]+$" },
    "evidence_type": {
      "enum": [
        "finite_computational_check",
        "counterexample_search",
        "symbolic_check",
        "property_check",
        "formal_proof"
      ]
    },
    "status": { "enum": ["passed", "failed", "inconclusive", "pending"] },
    "claim_scope": {
      "type": "object",
      "required": ["quantification", "universal_proof", "statement_zh"],
      "properties": {
        "quantification": {
          "enum": [
            "finite_declared_cases",
            "finite_declared_domain",
            "symbolic_declared_assumptions",
            "formal_universal"
          ]
        },
        "universal_proof": { "type": "boolean" },
        "statement_zh": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "runtime", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "runtime": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "formula_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "inconclusive", "pending"] }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "replay": {
      "type": "object",
      "required": ["command", "expected_exit_code", "source_artifact"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expected_exit_code": { "type": "integer" },
        "source_artifact": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "canonical_payload_sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonical_payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
