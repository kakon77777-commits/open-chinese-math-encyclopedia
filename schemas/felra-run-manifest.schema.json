{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/felra-run-manifest-v0.1.json",
  "title": "OCME FELRA Run Manifest v0.1",
  "type": "object",
  "required": [
    "schema_version", "subject_id", "project_id", "producer_version", "runtime",
    "command", "evidence_type", "status", "claim_scope", "checks", "limitations",
    "project_path", "result_sources", "replay"
  ],
  "properties": {
    "schema_version": { "const": "felra-run-manifest-v0.1" },
    "subject_id": { "type": "string", "pattern": "^mko-[a-z0-9-]+$" },
    "project_id": { "type": "string", "minLength": 1 },
    "producer_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "runtime": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "evidence_type": {
      "enum": ["finite_computational_check", "counterexample_search", "symbolic_check", "property_check"]
    },
    "status": { "enum": ["passed", "failed", "inconclusive"] },
    "claim_scope": {
      "type": "object",
      "required": ["quantification", "universal_proof", "statement_zh"],
      "properties": {
        "quantification": {
          "enum": ["finite_declared_cases", "finite_declared_domain", "symbolic_declared_assumptions"]
        },
        "universal_proof": { "const": false },
        "statement_zh": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "inconclusive"] }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "project_path": { "type": "string", "minLength": 1 },
    "result_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "replay": {
      "type": "object",
      "required": ["command", "expected_exit_code", "source_artifact"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expected_exit_code": { "type": "integer" },
        "source_artifact": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
