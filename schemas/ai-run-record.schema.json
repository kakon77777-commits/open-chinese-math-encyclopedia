{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/ai-run-record-v0.1.json",
  "title": "OCME AI Run Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "model",
    "model_version",
    "role",
    "prompt_id",
    "prompt_version",
    "prompt_class",
    "context_class",
    "source_set_id",
    "tool_set_id",
    "verification_goal",
    "input_sha256",
    "output_sha256",
    "started_at",
    "duration_ms",
    "usage",
    "billing",
    "network_used"
  ],
  "properties": {
    "schema_version": {"const": "ocme-ai-run-record-v0.1"},
    "run_id": {"type": "string", "pattern": "^ai-run-[a-z0-9][a-z0-9_-]*$", "minLength": 8},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "role": {"enum": ["designer", "builder", "verifier"]},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_class": {"type": "string", "minLength": 1},
    "context_class": {"type": "string", "minLength": 1},
    "source_set_id": {"type": "string", "minLength": 1},
    "tool_set_id": {"type": "string", "minLength": 1},
    "verification_goal": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "started_at": {"type": "string", "minLength": 20},
    "duration_ms": {"type": "integer", "minimum": 0},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_units", "output_units", "total_units", "cached_input_units"],
      "properties": {
        "input_units": {"type": "integer", "minimum": 0},
        "output_units": {"type": "integer", "minimum": 0},
        "total_units": {"type": "integer", "minimum": 0},
        "cached_input_units": {"type": "integer", "minimum": 0}
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount", "currency"],
      "properties": {
        "status": {"enum": ["not_computed", "estimated", "provider_reported"]},
        "amount": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "currency": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    },
    "network_used": {"type": "boolean"}
  }
}
