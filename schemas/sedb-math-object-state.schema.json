{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ocme/sedb-math-object-state-v0.1.json",
  "title": "OCME SEDB-Math Object State v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "object_id",
    "state",
    "content_version",
    "policy_version",
    "latest_event_id"
  ],
  "properties": {
    "schema_version": { "const": "ocme-sedb-math-object-state-v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "object_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "planned",
        "proposed",
        "draft",
        "under_review",
        "verified",
        "canonical",
        "contested",
        "revision_required",
        "deprecated",
        "superseded"
      ]
    },
    "content_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "latest_event_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
