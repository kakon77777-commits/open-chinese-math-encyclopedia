{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/classification-v0.1.json",
  "title": "OCME Classification Assertions v0.1",
  "type": "object",
  "required": ["schema_version", "object_id", "assertions", "external_classifications"],
  "properties": {
    "schema_version": { "const": "ocme-classification-v0.1" },
    "object_id": { "type": "string", "pattern": "^mko-" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "term_id", "role", "weight", "rationale_zh", "source"],
        "properties": {
          "axis": { "enum": ["domain", "subdomain", "object_kind", "method", "representation", "application", "tradition"] },
          "term_id": { "type": "string", "minLength": 2 },
          "role": { "enum": ["primary", "supporting", "contextual"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale_zh": { "type": "string", "minLength": 8 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "reviewed"],
            "properties": {
              "method": { "enum": ["expert_assessment", "source_import", "ai_candidate", "formal_dependency_analysis"] },
              "reviewed": { "type": "boolean" },
              "reviewer": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "external_classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "code", "relation", "status"],
        "properties": {
          "scheme": { "enum": ["MSC2020", "Wikidata", "OCME"] },
          "code": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["exact_match", "close_match", "broad_match", "narrow_match", "related_match"] },
          "status": { "enum": ["candidate", "reviewed", "rejected"] },
          "rationale_zh": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
