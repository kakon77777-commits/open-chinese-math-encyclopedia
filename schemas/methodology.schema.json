{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocme.example/schemas/methodology-v0.1.json",
  "title": "OCME Methodology Object v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title_zh", "category", "description_zh", "signals", "steps", "failure_modes", "related_methods", "review"],
  "properties": {
    "schema_version": { "const": "ocme-method-v0.1" },
    "id": { "type": "string", "pattern": "^method-" },
    "title_zh": { "type": "string", "minLength": 2 },
    "category": { "enum": ["proof", "problem_solving", "analysis_computation", "structural", "formal"] },
    "description_zh": { "type": "string", "minLength": 12 },
    "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "related_methods": { "type": "array", "items": { "type": "string", "pattern": "^method-" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": { "enum": ["candidate", "reviewed", "deprecated"] },
        "reviewer": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
